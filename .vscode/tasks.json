{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test All (Lint & Build)",
      "type": "shell",
      "command": "npm run lint && npm run build",
      "options": {
        "cwd": "${workspaceFolder}/milk_with_bro"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$eslint-stylish", "$tsc"]
    },
    {
      "label": "Lint Frontend",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/milk_with_bro"
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/milk_with_bro"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/milk_with_bro"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Server (Spring Boot)",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "windows": {
        "command": ".\\mvnw.cmd spring-boot:run"
      },
      "options": {
        "cwd": "${workspaceFolder}/coffee_with_bro"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Frontend & Server",
      "dependsOn": [
        "Start Frontend (Vite)",
        "Start Server (Spring Boot)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
