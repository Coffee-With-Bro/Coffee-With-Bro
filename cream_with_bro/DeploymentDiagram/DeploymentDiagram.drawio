        <!-- Main Host Device Node -->
        <mxCell id="nd_host" value="«device»&#xa;&lt;b style=&quot;font-size:15px;&quot;&gt;User Host Workstation / PC (localhost / 127.0.0.1)&lt;/b&gt;&#xa;OS: Windows / Linux / macOS — 100% Local Execution (Zero Cloud Dependency)" style="shape=cube;size=25;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;darkOpacity=0;fillColor=#f8f9fa;verticalAlign=top;fontSize=13;spacingTop=6;html=1;strokeColor=#4d4d4d;fontStyle=0;" vertex="1" parent="1">
