        <mxCell id="dp_ttl" value="Deployment Diagram — 100% Offline Local Architecture (Coffee With Bro)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
