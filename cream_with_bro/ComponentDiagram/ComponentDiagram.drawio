<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="comp-diag" name="Component Diagram">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="cp_ttl" value="Component Diagram — ASL Hand Sign Recognition System (Coffee With Bro)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1400" height="40" as="geometry" />
        </mxCell>

        <!-- Main System Boundary -->
        <mxCell id="box_sys" value="Coffee With Bro — 100% Offline Software Architecture" style="rounded=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=10;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="1400" height="1030" as="geometry" />
        </mxCell>

        <!-- External Actors -->
        <!-- User / Webcam -->
        <mxCell id="act_user" value="User /&#xa;Webcam Device" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="50" height="90" as="geometry" />
        </mxCell>
        <!-- ML Engineer / Admin -->
        <mxCell id="act_admin" value="ML Engineer /&#xa;Developer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="860" width="50" height="90" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- COMPONENT 1: React Frontend (milk_with_bro) -->
        <!-- ============================================== -->
        <mxCell id="cmp_fe" value="«component»&#xa;&lt;b style=&quot;font-size:14px;&quot;&gt;React 19 Frontend (milk_with_bro)&lt;/b&gt;" style="shape=module;align=left;spacingLeft=35;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="450" height="360" as="geometry" />
        </mxCell>

        <!-- Subcomponents inside Frontend -->
        <mxCell id="fe_sub1" value="Camera Viewfinder &amp; Canvas Grabber&#xa;• Video stream capture (getUserMedia)&#xa;• Downscales to 240px canvas every 350 ms&#xa;• Encodes JPEG data URL (quality 0.7)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="cmp_fe">
          <mxGeometry x="20" y="55" width="410" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fe_sub2" value="WebSocket Client (useSignTranslator hook)&#xa;• Manages ws://localhost:8080/ws/echo lifecycle&#xa;• Transmits Base64 frame snapshots&#xa;• Auto-reconnect with 2000 ms backoff" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="cmp_fe">
          <mxGeometry x="20" y="130" width="410" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fe_sub3" value="Transcript Builder &amp; Streak Filter&#xa;• Confidence threshold evaluation (&gt;= 0.85)&#xa;• 4-frame consecutive streak commit&#xa;• 1100 ms commit cooldown &amp; offline TTS speech" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="cmp_fe">
          <mxGeometry x="20" y="205" width="410" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fe_sub4" value="HUD, Lexicon Suggestion &amp; History UI&#xa;• Real-time confidence gauge &amp; gesture reference&#xa;• Autocomplete suggestions pill selector&#xa;• Translation session history viewer &amp; export" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="cmp_fe">
          <mxGeometry x="20" y="280" width="410" height="65" as="geometry" />
        </mxCell>

        <!-- Port on Frontend -->
        <mxCell id="p_fe_ws" value="Port" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;" vertex="1" parent="cmp_fe">
          <mxGeometry x="440" y="150" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p_fe_rest" value="Port" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;" vertex="1" parent="cmp_fe">
          <mxGeometry x="440" y="300" width="16" height="16" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- COMPONENT 2: Spring Boot Backend (coffee_with_bro) -->
        <!-- ============================================== -->
        <mxCell id="cmp_be" value="«component»&#xa;&lt;b style=&quot;font-size:14px;&quot;&gt;Spring Boot Backend (coffee_with_bro)&lt;/b&gt;" style="shape=module;align=left;spacingLeft=35;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="610" height="570" as="geometry" />
        </mxCell>

        <!-- Subcomponents inside Backend -->
        <mxCell id="be_sub1" value="WebSocket Subsystem (WebSocketConfig &amp; AslWebSocketHandler)&#xa;• Endpoint /ws/echo (TextWebSocketHandler)&#xa;• Base64 frame payload decoding -&gt; BufferedImage&#xa;• Pushes classification JSON: { &quot;label&quot;: &quot;A&quot;, &quot;confidence&quot;: 0.9412 }" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="cmp_be">
          <mxGeometry x="25" y="55" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="be_sub2" value="In-Process CNN Inference Engine (AslPredictor &amp; AslCnnModel)&#xa;• NativeImageLoader: resizes to 128x128x3 RGB&#xa;• ImagePreProcessingScaler: normalizes pixels to [0, 1]&#xa;• DeepLearning4j MultiLayerNetwork forward pass across 36 classes&#xa;• Synchronized execution &amp; top softmax argMax evaluation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="cmp_be">
          <mxGeometry x="25" y="135" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="be_sub3" value="In-Memory Lexicon Service (DictionaryService &amp; DictionaryController)&#xa;• Fast prefix search over NavigableSet&lt;String&gt; (64 vocabulary words)&#xa;• Endpoints: GET /api/dictionary/suggest, GET /api/dictionary/validate&#xa;• Autocomplete DTOs with case-insensitive ordering" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="cmp_be">
          <mxGeometry x="25" y="225" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="be_sub4" value="REST Telemetry &amp; System API (SystemApiController)&#xa;• Endpoint /api/status: system health, model loaded flag, class count (36)&#xa;• Endpoint /api/supported-signs: alphanumeric label enumeration&#xa;• Standby fallback handling when model weights are missing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="cmp_be">
          <mxGeometry x="25" y="305" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="be_sub5" value="Session Persistence Subsystem (TranslationSessionRepository)&#xa;• Spring Data JPA repository managing TranslationSession entities&#xa;• Endpoints: POST /api/sessions, GET /api/sessions, DELETE /api/sessions&#xa;• Aggregated metrics calculation (SessionStatsDto)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="cmp_be">
          <mxGeometry x="25" y="385" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="be_sub6" value="Exception &amp; Error Handling (GlobalExceptionHandler)&#xa;• @ControllerAdvice mapping domain errors to HTTP 400, 404, 500&#xa;• ResourceNotFoundException, InvalidSessionDataException" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="cmp_be">
          <mxGeometry x="25" y="465" width="560" height="55" as="geometry" />
        </mxCell>

        <!-- Ports on Backend -->
        <mxCell id="p_be_ws" value="Port" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;" vertex="1" parent="cmp_be">
          <mxGeometry x="-8" y="75" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p_be_rest" value="Port" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;" vertex="1" parent="cmp_be">
          <mxGeometry x="-8" y="270" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p_be_db" value="Port" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;" vertex="1" parent="cmp_be">
          <mxGeometry x="280" y="562" width="16" height="16" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- COMPONENT 3: Data Tier & Artifact Storage -->
        <!-- ============================================== -->
        <mxCell id="cmp_db" value="«component»&#xa;&lt;b style=&quot;font-size:13px;&quot;&gt;Embedded H2 Database&lt;/b&gt;&#xa;• Local SQL store&#xa;• TranslationSession table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=11;fontStyle=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1000" y="750" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cmp_store" value="«component»&#xa;&lt;b style=&quot;font-size:13px;&quot;&gt;Local Model Store&lt;/b&gt;&#xa;• asl_cnn_model.zip&#xa;• labels.txt (36 classes)" style="shape=module;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1250" y="750" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- COMPONENT 4: Offline Training Subsystem -->
        <!-- ============================================== -->
        <mxCell id="cmp_train" value="«component»&#xa;&lt;b style=&quot;font-size:14px;&quot;&gt;Offline Training &amp; Dataset Pipeline (ice_with_bro &amp; DL4J)&lt;/b&gt;" style="shape=module;align=left;spacingLeft=35;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="870" width="970" height="210" as="geometry" />
        </mxCell>

        <mxCell id="trn_sub1" value="Dataset Manager (ASL-HG Dataset)&#xa;• 36 alphanumeric classes (A-Z, 0-9)&#xa;• Local directory structure parsing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="cmp_train">
          <mxGeometry x="25" y="55" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="trn_sub2" value="Preprocessing &amp; Partitioning (Python / DL4J)&#xa;• Resize to 128x128 RGB with channel scaling&#xa;• 80 / 20 train-test partition with fixed seed (42)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="cmp_train">
          <mxGeometry x="340" y="55" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="trn_sub3" value="Model Trainer (TrainAslCnn)&#xa;• DeepLearning4j MultiLayerNetwork training&#xa;• 20 epochs, batch size 64, ScoreIterationListener&#xa;• Evaluates test accuracy per epoch &amp; saves best checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="cmp_train">
          <mxGeometry x="680" y="55" width="265" height="130" as="geometry" />
        </mxCell>

        <!-- Connectors & Interfaces -->
        <!-- User to Frontend -->
        <mxCell id="l_u_fe" value="Webcam Video Stream" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="act_user" target="cmp_fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frontend to Backend WebSocket -->
        <mxCell id="l_fe_be_ws" value="«protocol» WebSocket&#xa;/ws/echo (Frame Streaming)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#0066cc;fontSize=11;fontStyle=1;" edge="1" parent="1" source="p_fe_ws" target="p_be_ws">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frontend to Backend REST -->
        <mxCell id="l_fe_be_rest" value="«protocol» HTTP / JSON REST API&#xa;/api/status, /api/dictionary/*, /api/sessions" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#007a33;fontSize=11;fontStyle=1;" edge="1" parent="1" source="p_fe_rest" target="p_be_rest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend to H2 DB -->
        <mxCell id="l_be_h2" value="«JDBC / JPA»&#xa;Session Entities" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#9673a6;fontSize=11;fontStyle=1;" edge="1" parent="1" source="p_be_db" target="cmp_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend AslPredictor restores model from Model Store -->
        <mxCell id="l_be_store" value="Restores model.zip&#xa;&amp; labels.txt" style="endArrow=classic;dashed=1;html=1;strokeColor=#d79b00;fontSize=11;fontStyle=1;" edge="1" parent="1" source="cmp_store" target="cmp_be">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1335" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Trainer exports to Model Store -->
        <mxCell id="l_trn_store" value="Exports trained&#xa;weights &amp; labels" style="endArrow=classic;html=1;strokeColor=#d79b00;fontSize=11;fontStyle=1;" edge="1" parent="1" source="cmp_train" target="cmp_store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1335" y="975" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Admin to Training -->
        <mxCell id="l_adm_trn" value="Triggers Training&#xa;Pipeline" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="act_admin" target="cmp_train">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
