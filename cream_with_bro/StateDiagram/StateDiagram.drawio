<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="state-machine-diag" name="State Machine Diagram">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="st_ttl" value="State Machine Diagram — Real-Time Sign Recognition Lifecycle" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1400" height="40" as="geometry" />
        </mxCell>

        <!-- Initial Pseudo-State -->
        <mxCell id="st_init" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- State 1: Disconnected / Standby -->
        <mxCell id="s1" value="Disconnected / Standby&#xa;&#xa;entry / Initialize React hooks&#xa;do / Await user camera permission" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="105" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- Transition: Init to S1 -->
        <mxCell id="tr_init_s1" value="" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="st_init" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- State 2: Connecting -->
        <mxCell id="s2" value="Connecting&#xa;&#xa;entry / new WebSocket(ws://localhost:8080/ws/echo)&#xa;do / Await connection handshake" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="105" width="310" height="80" as="geometry" />
        </mxCell>

        <!-- Transition: S1 to S2 -->
        <mxCell id="tr_s1_s2" value="startSession() / requestCamera()" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- State 3: Reconnecting -->
        <mxCell id="s3_recon" value="Reconnecting&#xa;&#xa;entry / Start backoff timer (2000 ms)&#xa;do / Show reconnect HUD indicator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="240" width="310" height="75" as="geometry" />
        </mxCell>

        <!-- Transition S2 to Reconnecting -->
        <mxCell id="tr_s2_recon" value="[onClose or onError]" style="endArrow=classic;html=1;strokeColor=#b85450;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s2" target="s3_recon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Transition Reconnecting to S2 -->
        <mxCell id="tr_recon_s2" value="timerExpired (2000 ms)" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;fontStyle=1;" edge="1" parent="1" source="s3_recon" target="s2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="278" />
              <mxPoint x="490" y="145" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 4: Connected / Idle -->
        <mxCell id="s4_idle" value="Connected / Ready&#xa;&#xa;entry / setStatus(&quot;open&quot;); streakCount = 0&#xa;do / Display live camera viewfinder HUD" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="105" width="290" height="80" as="geometry" />
        </mxCell>

        <!-- Transition S2 to S4 -->
        <mxCell id="tr_s2_s4" value="[onOpen handshake success]" style="endArrow=classic;html=1;strokeColor=#274e13;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s2" target="s4_idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Composite Super-State: Streaming & Inference Loop -->
        <mxCell id="s_super" value="Streaming &amp; Real-Time Inference Superstate" style="swimlane;fontStyle=1;align=left;spacingLeft=10;startSize=30;horizontal=1;childLayout=stackLayout;horizontalStack=0;resizeParent=1;resizeParentMax=0;fillColor=#f8f9fa;strokeColor=#0066cc;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="1340" height="660" as="geometry" />
        </mxCell>

        <!-- Inner Content Area -->
        <mxCell id="s_super_body" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="s_super">
          <mxGeometry y="30" width="1340" height="630" as="geometry" />
        </mxCell>

        <!-- State 5: Frame Capturing -->
        <mxCell id="s5_cap" value="Frame Capturing&#xa;&#xa;entry / Reset captureTimer (350 ms)&#xa;do / Draw video to 240px canvas &amp; encode Base64 JPEG&#xa;exit / socket.send(dataUrl)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- Transition Idle to Frame Capturing -->
        <mxCell id="tr_idle_cap" value="startStreaming() / startCaptureLoop(350 ms)" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s4_idle" target="s5_cap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1105" y="270" />
              <mxPoint x="300" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 6: Awaiting Inference -->
        <mxCell id="s6_infer" value="Awaiting Inference&#xa;&#xa;do / Spring Boot AslWebSocketHandler processes frame:&#xa;     1. Base64 decode -&gt; BufferedImage&#xa;     2. DL4J AslPredictor: normalize 128x128x3 -&gt; forward pass&#xa;     3. Softmax top class &amp; confidence score computed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="420" width="410" height="110" as="geometry" />
        </mxCell>

        <!-- Transition S5 to S6 -->
        <mxCell id="tr_cap_infer" value="timerTick (350 ms) / transmitBase64Frame()" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s5_cap" target="s6_infer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- State 7: Confidence Evaluating -->
        <mxCell id="s7_eval" value="Evaluating Prediction&#xa;&#xa;entry / setLiveGuess({ label, confidence })&#xa;do / Evaluate confidence threshold (&gt;= 0.85)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="430" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- Transition S6 to S7 -->
        <mxCell id="tr_infer_eval" value="messageReceived {label, confidence}" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s6_infer" target="s7_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Low Confidence Branch -->
        <mxCell id="tr_low_conf" value="[confidence &lt; 0.85] /&#xa;streakLabel = null; streakCount = 0" style="endArrow=classic;html=1;strokeColor=#b85450;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s7_eval" target="s5_cap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1230" y="560" />
              <mxPoint x="300" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 8: Streak Accumulating -->
        <mxCell id="s8_streak" value="Streak Accumulating&#xa;&#xa;entry / [label == streakLabel] ? streakCount++ : streakCount = 1&#xa;do / Update on-screen HUD streak progress bar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="630" width="370" height="85" as="geometry" />
        </mxCell>

        <!-- Transition S7 to S8 -->
        <mxCell id="tr_eval_streak" value="[confidence &gt;= 0.85]" style="endArrow=classic;html=1;strokeColor=#274e13;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s7_eval" target="s8_streak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S8 Streak < 4 loop back to S5 -->
        <mxCell id="tr_streak_loop" value="[streakCount &lt; 4] / continue streaming" style="endArrow=classic;html=1;strokeColor=#0066cc;fontSize=10;fontStyle=1;" edge="1" parent="1" source="s8_streak" target="s5_cap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1025" y="740" />
              <mxPoint x="300" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 9: Letter Committed -->
        <mxCell id="s9_commit" value="Letter Committed&#xa;&#xa;entry / transcript += label&#xa;do / 1. cooldownUntil = now + 1100 ms&#xa;     2. streakCount = 0&#xa;     3. Trigger offline TTS audio speech" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- Transition S8 to S9 -->
        <mxCell id="tr_streak_commit" value="[streakCount &gt;= 4 &amp;amp;&amp;amp; now &gt;= cooldownUntil]" style="endArrow=classic;html=1;strokeColor=#9673a6;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s8_streak" target="s9_commit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Transition S9 back to S5 -->
        <mxCell id="tr_commit_cap" value="letterAppended / captureNextFrame" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s9_commit" target="s5_cap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="675" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 10: Lexicon Assisting (Parallel Action) -->
        <mxCell id="s10_dict" value="Lexicon Querying (REST)&#xa;&#xa;entry / GET /api/dictionary/suggest?q=prefix&#xa;do / Receive word completions [HELLO, HELP]&#xa;exit / Render clickable autocomplete suggestions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="810" width="370" height="90" as="geometry" />
        </mxCell>

        <!-- Transition Commit to Lexicon -->
        <mxCell id="tr_commit_dict" value="prefixChanged / queryLexicon()" style="endArrow=classic;html=1;strokeColor=#d6b656;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s9_commit" target="s10_dict">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="855" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 11: Session Persisting -->
        <mxCell id="s11_persist" value="Session Persisting (REST)&#xa;&#xa;entry / POST /api/sessions&#xa;do / Spring Data JPA writes TranslationSession into H2 DB&#xa;exit / Show success notification &amp; reload history modal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="810" width="390" height="90" as="geometry" />
        </mxCell>

        <!-- Transition to Session Persisting -->
        <mxCell id="tr_save_sess" value="onSaveSessionClick()" style="endArrow=classic;html=1;strokeColor=#0066cc;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s_super" target="s11_persist">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="805" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Final State -->
        <mxCell id="st_final" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1150" y="840" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Transition to Final -->
        <mxCell id="tr_persist_final" value="sessionClosed" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="s11_persist" target="st_final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Standby / Model Unavailable State -->
        <mxCell id="s_standby" value="Server Standby / Model Unavailable&#xa;&#xa;entry / Display alert &quot;ASL model is not loaded on server&quot;&#xa;do / Backend waits for model.zip &amp; labels.txt files" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="270" width="340" height="75" as="geometry" />
        </mxCell>

        <!-- Transition from S6 to Standby -->
        <mxCell id="tr_infer_standby" value="[error: model not loaded]" style="endArrow=classic;html=1;strokeColor=#b85450;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s6_infer" target="s_standby">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="785" y="380" />
              <mxPoint x="1250" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
