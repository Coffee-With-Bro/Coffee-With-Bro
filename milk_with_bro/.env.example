# ==========================================
# Coffee With Bro — Frontend Environment Variables
# ==========================================

# WebSocket URL for real-time ASL gesture streaming
# Local Default: ws://localhost:8080/ws/echo
# Cloud Example: wss://your-backend.railway.app/ws/echo
VITE_WS_URL=ws://localhost:8080/ws/echo

# REST API Base URL for telemetry, word autocomplete & session history
# Local Default: http://localhost:8080/api
# Cloud Example: https://your-backend.railway.app/api
VITE_API_URL=http://localhost:8080/api
