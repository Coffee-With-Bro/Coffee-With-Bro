# Server Port (automatically injected by cloud PaaS platforms like Railway / Render / Fly.io)
PORT=8080

# Active Spring Profile (e.g. prod, dev, test)
SPRING_PROFILES_ACTIVE=prod

# Path to trained DeepLearning4j ASL CNN model zip and class labels
ASL_MODEL_PATH=models/asl_cnn_model.zip
ASL_LABELS_PATH=models/labels.txt

# JVM options for cloud container resource management
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom

